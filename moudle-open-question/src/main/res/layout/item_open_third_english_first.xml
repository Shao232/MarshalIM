<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_mode"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_english_first"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:textColor="@color/black_mode"
                android:textSize="20dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="2.题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目题目"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/gray_line"
                app:layout_constraintTop_toBottomOf="@id/tv_title_english_first"/>

            <LinearLayout
                android:id="@+id/lvn_answer_select_group_third"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_english_first"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_answer_first_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginBottom="5dp"
                    android:checked="false"
                    android:background="@null"
                    android:button="@null"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/black_mode"
                    android:textSize="16dp"
                    tools:text="A.hello wge wdsgefewdsgefewdsgefewdsgefewdsgefewdsgefewdsgefewdsgefewdsgefe " />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:background="@color/gray_line"
                    app:layout_constraintTop_toBottomOf="@id/tv_title_english_first"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_answer_second_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:drawablePadding="6dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/black_mode"
                    android:textSize="16dp"
                    tools:text="A.hello wge wdsgefe " />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:background="@color/gray_line"
                    app:layout_constraintTop_toBottomOf="@id/tv_title_english_first"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_answer_third_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginBottom="5dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/black_mode"
                    android:textSize="16dp"
                    tools:text="A.hello wge wdsgefe " />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:background="@color/gray_line"
                    app:layout_constraintTop_toBottomOf="@id/tv_title_english_first"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_answer_fourth_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:drawablePadding="6dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/black_mode"
                    android:textSize="16dp"
                    tools:text="A.hello wge wdsgefe " />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:background="@color/gray_line"
                    app:layout_constraintTop_toBottomOf="@id/tv_title_english_first"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_english_to_chinese"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/black_mode"
                android:textSize="16dp"
                android:visibility="gone"
                tools:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_title_english_first"
                tools:text="A.hello wge wdsgefe " />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_answer_parse_third"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black_mode"
                android:textSize="18dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/lvn_answer_select_group_third"
                tools:text="答案解析:hhhhhhhhh "
                tools:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>


</androidx.core.widget.NestedScrollView>