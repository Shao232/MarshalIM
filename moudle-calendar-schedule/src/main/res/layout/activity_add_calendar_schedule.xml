<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_mode_white">

    <include layout="@layout/include_toolbar"/>

    <EditText
        android:id="@+id/edit_title_schedule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_custom"
        android:background="@drawable/edit_default_bg"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:hint="标题"
        android:textSize="16dp"
        android:textColor="@color/text_color_black"
        android:textColorHint="#A09B9B"
        android:paddingStart="20dp"/>


    <EditText
        android:id="@+id/edit_content_schedule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/edit_title_schedule"
        android:background="@drawable/edit_default_bg"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:hint="内容"
        android:textSize="16dp"
        android:textColor="@color/text_color_black"
        android:textColorHint="#A09B9B"
        android:paddingStart="20dp"/>

    <LinearLayout
        android:id="@+id/lvn_select_start_time_schedule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/edit_content_schedule"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/shape_default_bg"
        android:orientation="horizontal">

       <TextView
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1"
           android:text="开始时间"
           android:textColor="@color/text_color_black"
           android:textSize="14dp"
           android:gravity="center_vertical"
           android:layout_marginStart="10dp"/>

        <ImageView
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:src="@drawable/right_img"
            android:scaleType="centerInside"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lvn_select_end_time_schedule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/lvn_select_start_time_schedule"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/shape_default_bg"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="结束时间"
            android:textColor="@color/text_color_black"
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"/>

        <ImageView
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:src="@drawable/right_img"
            android:scaleType="centerInside"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lvn_select_plan_schedule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/lvn_select_end_time_schedule"
        android:layout_marginTop="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/shape_default_bg"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="所属规划"
            android:textColor="@color/text_color_black"
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"/>

        <TextView
            android:id="@+id/tv_select_plan_content_schedule"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:text="请选择"
            android:textColor="@color/text_color_black"
            android:textSize="14dp"
            android:gravity="center_vertical|end"/>

        <ImageView
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:src="@drawable/right_img"
            android:scaleType="centerInside"
            android:gravity="center_vertical"/>

    </LinearLayout>



    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tv_commit_schedule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/lvn_select_plan_schedule"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:background="@drawable/shape_default_bg"
        android:textColor="@color/text_color_black"
        android:textSize="24dp"
        android:text="提交"/>

</androidx.constraintlayout.widget.ConstraintLayout>