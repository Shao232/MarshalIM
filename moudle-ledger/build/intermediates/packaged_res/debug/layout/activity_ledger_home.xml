<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ledger_bg_page"
    android:orientation="vertical">

    <include layout="@layout/include_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ls_space_16"
        android:layout_marginTop="@dimen/ls_space_8"
        android:layout_marginEnd="@dimen/ls_space_16"
        android:background="@drawable/shape_ledger_summary"
        android:orientation="vertical"
        android:padding="@dimen/ls_space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ledger_month_expense_label"
            android:textAppearance="@style/TextAppearance.Ledger.OnBrand" />

        <TextView
            android:id="@+id/tv_month_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_space_4"
            android:text="@string/ledger_amount_zero"
            android:textAppearance="@style/TextAppearance.Ledger.Big" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_space_12"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_month_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ledger_month_income"
                android:textAppearance="@style/TextAppearance.Ledger.OnBrand" />

            <TextView
                android:id="@+id/tv_month_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_space_20"
                android:text="@string/ledger_month_balance"
                android:textAppearance="@style/TextAppearance.Ledger.OnBrand" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_budget"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/ls_space_16"
            android:max="100"
            android:progressDrawable="@drawable/progress_ledger_budget" />

        <TextView
            android:id="@+id/tv_budget_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_space_8"
            android:text="@string/ledger_budget_tip"
            android:textAppearance="@style/TextAppearance.Ledger.OnBrand" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ls_space_16"
            android:layout_marginTop="@dimen/ls_space_16"
            android:layout_marginEnd="@dimen/ls_space_16"
            android:background="@drawable/shape_ledger_card"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_ledger"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="@dimen/ls_space_4"
                android:paddingBottom="@dimen/ls_space_16" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/ledger_empty_tip"
            android:textAppearance="@style/TextAppearance.Ledger.Caption"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_ledger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/ls_space_20"
            android:contentDescription="@string/ledger_add_title"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/ledger_brand"
            app:fabSize="normal"
            app:tint="@android:color/white" />

    </FrameLayout>

</LinearLayout>
