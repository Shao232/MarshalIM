<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ledger_white"
    android:orientation="vertical"
    android:paddingStart="@dimen/ls_space_20"
    android:paddingEnd="@dimen/ls_space_20"
    android:paddingBottom="@dimen/ls_space_24">

    <include layout="@layout/include_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ls_space_8"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ls_space_8"
            android:text="@string/ledger_money_symbol"
            android:textColor="@color/ledger_brand"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_ledger_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/ledger_amount_zero"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Ledger.Money" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ledger_brand_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/ls_space_20"
        android:background="@drawable/shape_ledger_segment"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tv_type_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_ledger_segment"
            android:gravity="center"
            android:text="@string/ledger_type_expense"
            android:textAppearance="@style/TextAppearance.Ledger.Body" />

        <TextView
            android:id="@+id/tv_type_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_ledger_segment"
            android:gravity="center"
            android:text="@string/ledger_type_income"
            android:textAppearance="@style/TextAppearance.Ledger.Body" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ls_space_20"
        android:text="@string/ledger_category_label"
        android:textAppearance="@style/TextAppearance.Ledger.Caption" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ls_space_12"
        android:overScrollMode="never" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/ls_space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="@string/ledger_remark_label"
            android:textAppearance="@style/TextAppearance.Ledger.Body" />

        <EditText
            android:id="@+id/et_ledger_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/ledger_remark_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Ledger.Body" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ledger_line" />

    <TextView
        android:id="@+id/tv_ledger_date"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical|end"
        android:text="@string/ledger_date_today"
        android:textAppearance="@style/TextAppearance.Ledger.Body" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ledger_line" />

    <TextView
        android:id="@+id/btn_save_ledger"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/ls_space_24"
        android:background="@drawable/shape_ledger_btn_primary"
        android:gravity="center"
        android:text="@string/ledger_save"
        android:textColor="@color/ledger_white"
        android:textSize="@dimen/ls_text_title"
        android:textStyle="bold" />

</LinearLayout>
