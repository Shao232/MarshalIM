<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.PracticeActivity">

    <include layout="@layout/include_toolbar" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_subject"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/color_f4f4f4"
        app:layout_constraintBottom_toTopOf="@id/lvn_collection_and_error"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_custom" />

    <LinearLayout
        android:id="@+id/lvn_collection_and_error"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@color/white_ffffff"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewpager_subject"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/lvn_time_subject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_5"
                android:src="@drawable/subject_time_img" />

            <TextView
                android:id="@+id/tv_timer_exam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="60:00"
                android:textColor="@color/color_545454"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lvn_collection_subject"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="80dp"
            android:orientation="horizontal"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_collection_subject"
                android:layout_width="@dimen/dp_25"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/my_collections_img" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="收藏"
                android:textColor="@color/color_545454"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lvn_test_correct_subject"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="80dp"
            android:orientation="horizontal"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp_25"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:src="@drawable/subject_ok_img" />

            <TextView
                android:id="@+id/tv_yes_subject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textColor="@color/color_048ae9"
                android:textSize="@dimen/text_size_16"
                tools:text="1111" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lvn_test_error_subject"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="80dp"
            android:orientation="horizontal"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp_25"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/subject_no_img" />

            <TextView
                android:id="@+id/tv_no_subject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textColor="@color/color_f4011f"
                android:textSize="@dimen/text_size_16"
                tools:text="1011" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_question_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="80dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:textStyle="bold"
            android:textColor="@color/black_000000"
            android:textSize="@dimen/text_size_16"
            tools:text="1/1120" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>