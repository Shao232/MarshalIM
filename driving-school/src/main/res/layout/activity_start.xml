<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_toolbar" />


    <ImageView
        android:id="@+id/iv_user_head_question_start"
        android:layout_width="@dimen/dp_70"
        android:layout_height="@dimen/dp_70"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_30"
        tools:src="@drawable/defult_img" />

    <TextView
        android:id="@+id/tv_user_nickname_question_start"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_20"
        android:gravity="center"
        android:textColor="@color/black_333333"
        android:textSize="@dimen/text_size_16"
        android:textStyle="bold"
        tools:text="1111" />

    <TextView
        android:id="@+id/tv_exam_num_question_start"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_4"
        android:gravity="center"
        android:textColor="@color/color_242424"
        android:textSize="@dimen/text_size_12"
        tools:text="您今天已经模拟了4次，继续加油哦！" />

    <FrameLayout
        android:layout_width="@dimen/dp_330"
        android:layout_height="@dimen/dp_170"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/dp_20">

        <ImageView
            android:layout_width="@dimen/dp_340"
            android:layout_height="@dimen/dp_170"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_5"
            android:scaleType="fitXY"
            android:src="@drawable/start_question_1_img" />

        <LinearLayout
            android:layout_width="@dimen/dp_260"
            android:layout_height="@dimen/dp_20"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_40">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="考试科目"
                android:textColor="@color/black_000000"
                android:textSize="@dimen/text_size_14" />

            <TextView
                android:id="@+id/tv_question_type"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|right"
                android:text="科目1"
                android:textColor="@color/color_545454"
                android:textSize="@dimen/text_size_14" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/dp_260"
            android:layout_height="@dimen/dp_20"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_70">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="驾照类型"
                android:textColor="@color/black_000000"
                android:textSize="@dimen/text_size_14" />

            <TextView
                android:id="@+id/tv_car_type"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|right"
                android:text="小型车辆"
                android:textColor="@color/color_545454"
                android:textSize="@dimen/text_size_14" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/dp_260"
            android:layout_height="@dimen/dp_20"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="考试时间"
                android:textColor="@color/black_000000"
                android:textSize="@dimen/text_size_14" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|right"
                android:text="45分钟"
                android:textColor="@color/color_545454"
                android:textSize="@dimen/text_size_14" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/dp_260"
            android:layout_height="@dimen/dp_20"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_130">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="合格标准"
                android:textColor="@color/black_000000"
                android:textSize="@dimen/text_size_14" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:gravity="center_vertical|right"
                android:text="满分100分，90分合格"
                android:textColor="@color/color_545454"
                android:textSize="@dimen/text_size_14" />

        </LinearLayout>


    </FrameLayout>

    <Button
        android:id="@+id/btn_start_questions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_margin="@dimen/dp_20"
        android:background="@drawable/selector_start_question"
        android:text="开始模拟答题"
        android:textColor="@color/white_ffffff"
        android:textSize="@dimen/text_size_18" />

</LinearLayout>
