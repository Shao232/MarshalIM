<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_mode_white"
    tools:context="com.marshal.android.WanHomeFragment">

    <include layout="@layout/include_toolbar" />

    <com.youth.banner.Banner
        android:id="@+id/banner_home_wan"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_custom" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        app:layout_constraintTop_toBottomOf="@id/banner_home_wan"
        android:textSize="18sp"
        android:textColor="@color/black_mode"
        android:text="HomeFragment"
        android:gravity="center"/>


</androidx.constraintlayout.widget.ConstraintLayout>