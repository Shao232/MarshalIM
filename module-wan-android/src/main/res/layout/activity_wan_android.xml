<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.marshal.android.main.WanAndroidActivity"
    android:background="@color/bg_mode_white">


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_wan_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tab_layout_wan_main"/>

     <com.google.android.material.tabs.TabLayout
         android:id="@+id/tab_layout_wan_main"
         android:layout_width="match_parent"
         android:layout_height="50dp"
         android:background="@color/white_mode"
         app:tabMode="fixed"
         app:tabIndicatorHeight="2dp"
         app:tabTextColor="@color/text_color_black"
         app:tabSelectedTextColor="@color/text_color_black"
         app:tabBackground="@color/bg_mode_white"
         app:tabPaddingStart="0dp"
         app:tabPaddingEnd="0dp"
         app:tabPaddingTop="0dp"
         app:tabPaddingBottom="0dp"
         app:layout_constraintBottom_toBottomOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toBottomOf="@id/view_pager_wan_main"
     />



</androidx.constraintlayout.widget.ConstraintLayout>