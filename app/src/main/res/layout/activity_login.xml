<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity">

    <include layout="@layout/include_toolbar" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_logo_login_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/icon_marshal_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_custom" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_user_name_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/login_user_name_bg"
        android:hint="账号"
        android:minHeight="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="0dp"
        android:textColor="@color/text_color_black"
        android:textColorHint="@color/text_color_gray_hint"
        android:textSize="18dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_logo_login_tag" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_user_password_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/login_user_name_bg"
        android:hint="密码"
        android:minHeight="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="0dp"
        android:textColor="@color/text_color_black"
        android:textColorHint="@color/text_color_gray_hint"
        android:textSize="18dp"
        app:layout_constraintTop_toBottomOf="@id/edit_user_name_login" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        app:layout_constraintTop_toBottomOf="@id/edit_user_password_login"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="@dimen/dp_50"
        android:layout_marginTop="20dp"
        android:text="登录"
        android:textSize="18dp"
        android:textColor="@color/black_mode"
        />


</androidx.constraintlayout.widget.ConstraintLayout>