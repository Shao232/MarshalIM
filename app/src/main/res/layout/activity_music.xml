<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_mode"
    tools:context=".music.MusicActivity">

    <include layout="@layout/include_toolbar" />

    <TextView
        android:id="@+id/tv_service_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:textColor="@color/home_text_sub"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_custom"
        tools:text="空白页，用下面按钮练 Service" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_service_status">

        <TextView
            android:id="@+id/btn_start_service"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/shape_home_card"
            android:gravity="center"
            android:text="启动服务 startService"
            android:textColor="@color/home_text_main"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_stop_service"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_home_card"
            android:gravity="center"
            android:text="停止服务 stopService"
            android:textColor="@color/home_text_main"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_bind_service"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_home_card"
            android:gravity="center"
            android:text="绑定服务 bindService"
            android:textColor="@color/home_text_main"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_unbind_service"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_home_card"
            android:gravity="center"
            android:text="解绑服务 unbindService"
            android:textColor="@color/home_text_main"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
