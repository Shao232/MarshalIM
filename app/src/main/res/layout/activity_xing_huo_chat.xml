<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".xinghuochat.HuoChatActivity">

    <include layout="@layout/include_toolbar"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_chat_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_custom"
        app:layout_constraintBottom_toTopOf="@id/edit_send_text_chat"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_send_text_chat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="请输入你的问题"
        android:padding="4dp"
        tools:text="hello 111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题111111hahahhh很长的问题2222222333444"
        android:textColor="@color/black_mode"
        android:textSize="20dp"
        android:maxLines="5"
        app:layout_constraintTop_toBottomOf="@+id/recycler_chat_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_send_chat"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_send_chat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="发送"
        android:textColor="@color/black_mode"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@id/edit_send_text_chat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/edit_send_text_chat" />


</androidx.constraintlayout.widget.ConstraintLayout>