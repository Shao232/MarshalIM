<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mine.UDPConnectActivity">

    <TextView
        android:id="@+id/tv_send_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="发送: "
        android:textColor="@color/text_color_black"
        android:textSize="18dp"
        android:gravity="start"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/view_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_line"
        app:layout_constraintTop_toBottomOf="@id/tv_send_data"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_receive_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="接收: "
        android:textColor="@color/text_color_black"
        android:textSize="18dp"
        android:padding="6dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/view_line"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/edit_send_data"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_receive_data"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_send"
        android:layout_marginTop="5dp"
        android:hint="请输入发送内容"
        android:textSize="16dp"
        android:textColor="@color/text_color_black"/>

    <Button
        android:id="@+id/btn_send"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_receive_data"
        app:layout_constraintBottom_toBottomOf="@id/edit_send_data"
        android:text="发送"
        android:textColor="@color/text_color_black"
        android:textSize="16dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>