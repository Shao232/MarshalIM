<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".music.IMPhoneActivity">

    <EditText
        android:id="@+id/edit_phone_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="@color/bg_mode_white"
        app:layout_constraintTop_toTopOf="parent"
        android:hint="请输入电话号码"
        android:textColorHint="@color/black"
        android:inputType="phone"
        android:paddingStart="10dp"
        android:paddingEnd="0dp"/>

    <Button
        android:id="@+id/btn_call_phone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="打电话"
        android:textSize="18dp"
        android:textColor="@color/text_color_black"
        app:layout_constraintTop_toBottomOf="@+id/edit_phone_number"
        />

    <TextView
        android:id="@+id/tv_show_recorder_file"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_call_phone"
        tools:text="录音文件地址"
        android:textColor="@color/black"
        android:textSize="18dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="0dp"/>

    <Button
        android:id="@+id/btn_recorder_play"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="播放录音"
        android:textSize="18dp"
        android:textColor="@color/text_color_black"
        app:layout_constraintTop_toBottomOf="@+id/tv_show_recorder_file"
        />

    <Button
        android:id="@+id/btn_recorder"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="开始录音"
        android:textSize="18dp"
        android:textColor="@color/text_color_black"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_recorder_play"
        />


    <Button
        android:id="@+id/btn_recorder_clean"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="清空录音文件夹"
        android:textSize="18dp"
        android:textColor="@color/text_color_black"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_recorder"
        />




</androidx.constraintlayout.widget.ConstraintLayout>