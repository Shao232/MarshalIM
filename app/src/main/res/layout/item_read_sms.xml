<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:minHeight="@dimen/dp_60"
    android:background="@color/white_mode">

    <TextView
        android:id="@+id/tv_read_sms_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="test titletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitletitle"
        android:textSize="24dp"
        android:textColor="@color/text_color_black"
        android:gravity="top|start"
        android:ellipsize="end"
        android:maxLines="2"
        android:layout_marginTop="5dp"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_read_sms_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="test content "
        android:textSize="18dp"
        android:textColor="@color/text_color_black"
        android:maxLines="6"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tv_read_sms_title"
        app:layout_constraintStart_toStartOf="@id/tv_read_sms_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_line"
        app:layout_constraintTop_toBottomOf="@id/tv_read_sms_content"/>


</androidx.constraintlayout.widget.ConstraintLayout>