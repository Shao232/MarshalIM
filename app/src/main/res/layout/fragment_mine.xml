<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg_page"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <!-- ============ 品牌卡 ============ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/home_brand"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_mine_logo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@color/home_brand_block"
                android:gravity="center"
                android:text="样"
                android:textColor="@color/white_mode"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_nick_name_mine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white_mode"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_mine_slogan"
                app:layout_constraintEnd_toStartOf="@id/iv_setting_mine"
                app:layout_constraintStart_toEndOf="@id/tv_mine_logo"
                app:layout_constraintTop_toTopOf="@id/tv_mine_logo"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="marshal" />

            <TextView
                android:id="@+id/tv_mine_slogan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="样样有 · 你的随身百宝箱"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_mine_logo"
                app:layout_constraintEnd_toStartOf="@id/iv_setting_mine"
                app:layout_constraintStart_toEndOf="@id/tv_mine_logo"
                app:layout_constraintTop_toBottomOf="@id/tv_nick_name_mine" />

            <ImageView
                android:id="@+id/iv_setting_mine"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_setting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white_mode" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============ 我的记录 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="我的记录"
            android:textColor="@color/home_text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_home_card"
            android:orientation="vertical">

            <!-- 驾校错题 -->
            <LinearLayout
                android:id="@+id/row_driving_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@color/home_c_question_bg"
                    android:gravity="center"
                    android:text="错"
                    android:textColor="@color/home_c_question_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="驾校错题"
                    android:textColor="@color/home_text_main"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/home_text_hint"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="66dp"
                android:background="@color/home_line" />

            <!-- 玩安卓 -->
            <LinearLayout
                android:id="@+id/row_wan_android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@color/home_c_wan_bg"
                    android:gravity="center"
                    android:text="玩"
                    android:textColor="@color/home_c_wan_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="玩安卓"
                    android:textColor="@color/home_text_main"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/home_text_hint"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 通用 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="通用"
            android:textColor="@color/home_text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_home_card"
            android:orientation="vertical">

            <!-- 关于版本 -->
            <LinearLayout
                android:id="@+id/btn_to_about_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@color/home_c_schedule_bg"
                    android:gravity="center"
                    android:text="关"
                    android:textColor="@color/home_c_schedule_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="关于版本"
                    android:textColor="@color/home_text_main"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/home_text_hint"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="66dp"
                android:background="@color/home_line" />

            <!-- 退出登录 -->
            <LinearLayout
                android:id="@+id/btn_to_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@color/home_c_expense_bg"
                    android:gravity="center"
                    android:text="退"
                    android:textColor="@color/home_danger"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="退出登录"
                    android:textColor="@color/home_danger"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/home_text_hint"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
