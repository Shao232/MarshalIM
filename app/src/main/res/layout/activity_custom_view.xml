    <LinearLayout
        android:id="@+id/lvn_show_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        android:background="@color/white_mode"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/toolbar_custom"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_custom" >

        <TextView
            android:id="@+id/tv_show"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="展示列表"
            android:textSize="18dp"
            android:textColor="@color/text_color_black"
            android:gravity="center"/>



        <TextView
            android:id="@+id/tv_item_one"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="item1"
            android:textSize="18dp"
            android:textColor="@color/text_color_black"
            android:gravity="center"
            android:visibility="gone"/>


        <TextView
            android:id="@+id/tv_item_two"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="item2"
            android:textSize="18dp"
