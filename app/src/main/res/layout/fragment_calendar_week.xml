<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.marshal.calendar.CustomWeekCalendarView
                android:id="@+id/custom_week_view"
                android:layout_width="match_parent"
                android:layout_height="1100dp"
                android:visibility="gone" />

            <com.marshal.calendar.CustomDayCalendarView
                android:id="@+id/custom_calendar_view"
                android:layout_width="match_parent"
                android:layout_height="1100dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

<!--    <com.marshal.calendar.DragRectView-->
<!--        android:id="@+id/drag_rect_view"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:visibility="gone"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_add_schedule_show"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="240dp"
        android:background="@drawable/shape_add_schedule_bg"
        android:padding="12dp"
        android:src="@drawable/icon_schedule_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/scroll_view" />


</androidx.constraintlayout.widget.ConstraintLayout>